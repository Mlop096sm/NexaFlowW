       target="_blank" class="floating-cs" title="点击联系客服">
        <svg viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
            <path d="M12 2C6.48 2 2 6.48 2 12v4.5c0 1.93 1.57 3.5 3.5 3.5h1c.55 0 1-.45 1-1v-5c0-.55-.45-1-1-1H5.5c-.28 0-.5-.22-.5-.5V12c0-3.86 3.14-7 7-7s7 3.14 7 7v.5c0 .28-.22.5-.5.5H17c-.55 0-1 .45-1 1v5c0 .55.45 1 1 1h1.5c1.93 0 3.5-1.57 3.5-3.5V12c0-5.52-4.48-10-10-10zm-7 12h1v4H5c-.83 0-1.5-.67-1.5-1.5v-1c0-.83.67-1.5 1.5-1.5zm14 4h-1v-4h1c.83 0 1.5.67 1.5 1.5v1c0 .83-.67 1.5-1.5 1.5z"/>
