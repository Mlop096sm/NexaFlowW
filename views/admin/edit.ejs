<%- include('../partials/header', { title, active: '' }) %>

<div class="container">

    <div class="admin-top">
        <h2><%= item ? '编辑新闻' : '新增新闻' %></h2>
        <div class="admin-actions">
            <a href="/admin" class="btn btn-plain">← 返回列表</a>
        </div>
    </div>

    <% if (error) { %><div class="login-error"><%= error %></div><% } %>

    <form method="post" action="/admin/save" class="admin-form">
        <input type="hidden" name="_token" value="<%= csrfToken %>">
        <input type="hidden" name="id" value="<%= item ? item.id : '' %>">

        <div class="form-group">
            <label>标题 <span class="req">*</span></label>
            <input type="text" name="title" class="form-control" required maxlength="120" value="<%= item ? item.title : '' %>">
        </div>

        <div class="form-row">
            <div class="form-group">
                <label>分类 <span class="req">*</span></label>
                <select name="category" class="form-control">
                    <% Object.keys(categories).forEach(function(c){ %>
                    <option value="<%= c %>" <%= item && item.category === c ? 'selected' : '' %>><%= categories[c] %></option>
                    <% }) %>
                </select>
            </div>
            <div class="form-group">
                <label>来源</label>
                <input type="text" name="source" class="form-control" maxlength="80" placeholder="如：邺山村村委会" value="<%= item ? item.source : '' %>">
            </div>
            <div class="form-group">
                <label>发布时间</label>
                <input type="text" name="publish_date" class="form-control" maxlength="40" placeholder="如：2025-01-05" value="<%= item ? item.publish_date : '' %>">
            </div>
        </div>

        <div class="form-group">
            <label>摘要</label>
            <textarea name="summary" class="form-control" style="min-height:90px;" maxlength="500" placeholder="列表页展示的摘要，不超过 500 字"><%= item ? item.summary : '' %></textarea>
        </div>

        <div class="form-group">
            <label>正文 <span class="req">*</span></label>
            <textarea name="content" class="form-control" required placeholder="正文内容，段落之间用空行分隔"><%= item ? item.content : '' %></textarea>
            <div class="form-hint">多个段落之间用空行分隔，保存后自动分段显示；内容按纯文本输出，安全转义。</div>
        </div>

        <div class="form-check">
            <label><input type="checkbox" name="is_top" <%= item && item.is_top ? 'checked' : '' %>> 设为置顶头条</label>
            <label><input type="checkbox" name="is_secret" <%= item && item.is_secret ? 'checked' : '' %>> 设为绝密档案（仅在首页绝密区展示）</label>
        </div>

        <button type="submit" class="btn btn-primary">保存</button>
        <a href="/admin" class="btn btn-plain">取消</a>
    </form>

</div>

<%- include('../partials/footer') %>
