    <!-- 导航栏 -->
    <header>
        <div class="nav-container">
            <div class="logo-area">
                <div class="logo-img">邺山</div>
                <a class="logo-text" href="/">邺山村新闻中心</a>
            </div>
            <form class="search-area" action="/news" method="get">
                <input type="text" name="q" class="search-input" placeholder="搜索新闻、公告、财务..." value="<%= typeof kw !== 'undefined' && kw ? kw : '' %>">
                <button class="search-btn" type="submit">搜索</button>
            </form>
            <nav>
                <ul>
                    <li><a href="/" class="<%= active === 'home' ? 'active' : '' %>">首页</a></li>
                    <li><a href="/news" class="<%= active === 'news' ? 'active' : '' %>">新闻中心</a></li>
                    <li><a href="/revitalize" class="<%= active === 'revitalize' ? 'active' : '' %>">乡村振兴</a></li>
                    <li><a href="/village" class="<%= active === 'village' ? 'active' : '' %>">村情简介</a></li>
                </ul>
            </nav>
        </div>
    </header>

